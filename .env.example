# Copy to .env (or .env.local) and change the passwords before sharing the site with anyone.

# Leave DATABASE_URL unset to use the built-in PGlite database in ./.data/pglite.
# Set it to use a real PostgreSQL server instead:
# DATABASE_URL=postgres://user:password@localhost:5432/uthandar

# PGLITE_DIR=./.data/pglite
WORLD_SLUG=uthandar

# Accounts created by `npm run setup` (only if they don't already exist).
SEED_DM_EMAIL=dm@uthandar.local
SEED_DM_PASSWORD=change-me-before-sharing
SEED_DM_NAME=Dungeon Master
SEED_PLAYER_EMAIL=player@uthandar.local
SEED_PLAYER_PASSWORD=change-me-too

# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Public address when hosted (used in /api/openapi.json for ChatGPT Actions).
# PUBLIC_URL=https://guide.example.com

# Where "Check the inbox" and "Write snapshot" read/write (defaults shown).
# INBOX_DIR=./content/inbox
# SNAPSHOT_DIR=./content/world
